              }
            }
          }
        },
        "tags": [
          "brightness_api"
        ]
      },
      "post": {
        "summary": "Set LED brightness.",
        "responses": {
          "200": {
            "description": "Brightness set successfully",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "brightness": {
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing brightness value"
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "brightness"
              ],
              "properties": {
                "brightness": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255,
                  "description": "The target brightness level"
                }
              }
            }
          }
        ],
        "consumes": [
          "application/json"
        ],
        "tags": [
          "brightness_api"
        ]
      }
    },
    "/api/brightness/stream": {
      "get": {
        "summary": "Stream brightness updates.",
        "description": "Emits the current brightness object as an SSE `data:` event every second.",
        "responses": {
          "200": {
            "description": "text/event-stream of brightness values",
