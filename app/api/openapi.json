    "/api/seed": {
      "get": {
        "summary": "Populate database with flat default settings mapped to 3 distinct groups.",
        "responses": {
          "200": {
            "description": "Database seeded or already seeded"
          }
        },
        "tags": [
          "settings_api"
        ]
      }
    },
    "/api/settings": {
      "get": {
        "summary": "Fetch all settings groups with nested settings matching your structured JSON output.",
        "responses": {
          "200": {
            "description": "List of groups with nested settings",
            "schema": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "tags": [
          "settings_api"
        ]
      },
      "post": {
        "summary": "Create a new individual Setting.",
        "responses": {
          "201": {
            "description": "Setting created successfully"
          },
          "400": {
            "description": "Missing required fields or invalid value_type"
          },
          "404": {
            "description": "Group ID not found"
          },
          "409": {
            "description": "Setting key already exists"
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "name",
                "setting_key",
                "value",
                "settings_group_id"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "setting_key": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "settings_group_id": {
                  "type": "integer"
                },
                "value_type": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "consumes": [
          "application/json"
        ],
        "tags": [
          "settings_api"
        ]
      }
    },
    "/api/settings/{key}": {
      "get": {
        "summary": "Fetch any single setting dynamically by key using to_dict().",
        "responses": {
          "200": {
            "description": "Setting found",
            "schema": {
              "type": "object"
            }
          },
          "404": {
            "description": "Setting not found"
          }
        },
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Setting key identifier"
          }
        ],
        "tags": [
          "settings_api"
        ]
      }
    },
    "/api/groups/{group_id}": {
      "delete": {
        "summary": "Delete a setting group (cascades to associated settings).",
        "responses": {
          "200": {
            "description": "Group deleted successfully"
          },
          "404": {
            "description": "Group not found"
          }
        },
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "Group ID to delete"
          }
        ],
        "tags": [
